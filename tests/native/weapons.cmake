# Chat4 requirement-derived native ports; integrator includes this explicitly.
add_executable(f22_weapons_ground_clock native/weapons_ground_clock.cpp)
target_compile_features(f22_weapons_ground_clock PRIVATE cxx_std_23)
target_include_directories(f22_weapons_ground_clock PRIVATE "${PROJECT_SOURCE_DIR}/EFM/include")
target_compile_definitions(f22_weapons_ground_clock PRIVATE NOMINMAX _USE_MATH_DEFINES)
if(MSVC)
    target_compile_options(f22_weapons_ground_clock PRIVATE /W4)
endif()
add_test(NAME replacement_weapons_ground_clock COMMAND f22_weapons_ground_clock)

foreach(case_name bomb_flight tof_flight)
    add_executable(f22_weapons_${case_name} native/weapons_${case_name}.cpp)
    target_compile_features(f22_weapons_${case_name} PRIVATE cxx_std_23)
    target_include_directories(f22_weapons_${case_name} PRIVATE "${PROJECT_SOURCE_DIR}/EFM/include")
    target_compile_definitions(f22_weapons_${case_name} PRIVATE NOMINMAX _USE_MATH_DEFINES)
    if(MSVC)
        target_compile_options(f22_weapons_${case_name} PRIVATE /W4)
    endif()
    add_test(NAME replacement_weapons_${case_name} COMMAND f22_weapons_${case_name})
endforeach()
