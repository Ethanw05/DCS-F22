# Build-time identity only. Generated sources stay in the explicit build tree.
if(NOT DEFINED NATIVE_ROOT OR NOT DEFINED OUTPUT OR NOT DEFINED BUILD_CACHE)
    message(FATAL_ERROR "Explicit native root, output and build cache are required")
endif()
foreach(value IN ITEMS COMPILER CONFIGURATION)
    if(NOT "${${value}}" MATCHES "^[A-Za-z0-9_.+-]+$")
        message(FATAL_ERROR "Invalid build identity ${value}")
    endif()
endforeach()
file(GLOB_RECURSE inputs RELATIVE "${NATIVE_ROOT}"
    "${NATIVE_ROOT}/source/*.cpp" "${NATIVE_ROOT}/source/*.h" "${NATIVE_ROOT}/include/*.h")
list(SORT inputs)
set(material "")
foreach(input IN LISTS inputs)
    file(SHA256 "${NATIVE_ROOT}/${input}" digest)
    string(APPEND material "${input}=${digest}\n")
endforeach()
file(SHA256 "${NATIVE_ROOT}/CMakeLists.txt" cmake_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" generator_hash)
file(SHA256 "${BUILD_CACHE}" cache_hash)
string(APPEND material "cmake=${cmake_hash}\ngenerator=${generator_hash}\n")
string(SHA256 source_hash "${material}")
set(source "// Generated build identity; no host callbacks or runtime initialization.\n")
string(APPEND source "extern \"C\" __declspec(dllexport) const char f22_build_identity[] =\n")
string(APPEND source "    \"F22_NATIVE_V1|source=${source_hash}|\"\n")
string(APPEND source "    \"cache=${cache_hash}|\"\n")
string(APPEND source "    \"compiler=${COMPILER}|config=${CONFIGURATION}|cxx=23\";\n")
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
else()
    set(existing "")
endif()
if(NOT source STREQUAL existing)
    file(WRITE "${OUTPUT}" "${source}")
endif()
