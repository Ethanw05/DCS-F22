+        if(lifetime){++lifetime->owners;++lifetime->copies;}
+    }
+    TrackedVisitor(TrackedVisitor&& other) noexcept :lifetime(other.lifetime) { other.lifetime=nullptr; }
+    ~TrackedVisitor() { if(lifetime){--lifetime->owners;++lifetime->destroyed;} }
